# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://profit:profit@localhost:5432/profitdb

# SQLite (development, no installation required)
# DATABASE_URL=sqlite+aiosqlite:///./profit.db

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=PROFIT Loyalty
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Wheel of Fortune ──────────────────────────────────────────────────────────
WHEEL_FREE_INTERVAL_HOURS=72
WHEEL_PAID_COST_MD=50

# ── Referral ──────────────────────────────────────────────────────────────────
REFERRAL_BONUS_MD=100
